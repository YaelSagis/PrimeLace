import React, { useState, useEffect } from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { AdminCategories } from './categories';
import { AdminRentings } from './rentings';
import { AdminUsers } from './users';
import { getAllCategoriesThunk } from '../../redux/slices/categoriesSlice';
import { getAllRentings } from '../../API/rentingsApi';
import { getAllUsers } from '../../API/usersApi';
import { AdminCharts } from './adminCharts';
import '../../styles/adminDashboard.css';

export function AdminDashboard() {
    const dispatch = useDispatch();
    const [activeTab, setActiveTab] = useState('overview'); // overview, categories, rentings, users

    // נתונים מהסטייט ומה-API
    const categories = useSelector((state) => state.categories.categories) || [];
    const [rentings, setRentings] = useState([]);
    const [users, setUsers] = useState([]);
    const [loadingStats, setLoadingStats] = useState(true);

    useEffect(() => {
        const fetchDashboardData = async () => {
            try {
                dispatch(getAllCategoriesThunk());
                const rentingsData = await getAllRentings();
                const usersData = await getAllUsers();
                setRentings(rentingsData || []);
                setUsers(usersData || []);
            } catch (err) {
                console.error("שגיאה בטעינת נתוני לוח הבקרה", err);
            } finally {
                setLoadingStats(false);
            }
        };
        fetchDashboardData();
    }, [dispatch]);

    // חישוב מדדים סטטיסטיים
    const totalRevenue = rentings.reduce((acc, curr) => acc + (Number(curr.totalAmount) || 0), 0);
    const activeRentingsCount = rentings.filter(r => r.status === 'active' || r.status === 'confirmed').length;
    const totalClients = users.filter(u => u.userType !== 'admin').length;

    return (
        <div className="admin-dashboard-page">
            <div className="admin-header-section">
                <h1 className="admin-main-title">PrimeLace Studio</h1>
                <p className="admin-subtitle">פאנל ניהול ובקרה מתקדם</p>
            </div>

            {/* תפריט ניווט פנימי של הניהול */}
            <div className="admin-tabs-nav">
                <button 
                    className={`admin-tab-btn ${activeTab === 'overview' ? 'active' : ''}`}
                    onClick={() => setActiveTab('overview')}
                >
                    ✦סקירה כללית ונתונים
                </button>
                <button 
                    className={`admin-tab-btn ${activeTab === 'categories' ? 'active' : ''}`}
                    onClick={() => setActiveTab('categories')}
                >
                    ניהול קטגוריות
                </button>
                <button 
                    className={`admin-tab-btn ${activeTab === 'rentings' ? 'active' : ''}`}
                    onClick={() => setActiveTab('rentings')}
                >
                    ניהול הזמנות והשכרות
                </button>
                <button 
                    className={`admin-tab-btn ${activeTab === 'users' ? 'active' : ''}`}
                    onClick={() => setActiveTab('users')}
                >
                    ניהול לקוחות
                </button>
            </div>

            {/* תוכן הטאבים */}
            <div className="admin-tab-content">
                {activeTab === 'overview' && (
                    <div className="overview-container">
                        {/* כרטיסיות נתונים (KPI Cards) */}
                        <div className="kpi-grid">
                            <div className="kpi-card">
                                <span className="kpi-title">סך הכנסות משוערות</span>
                                <span className="kpi-value">₪{totalRevenue.toLocaleString()}</span>
                                <span className="kpi-sub">מהשכרות פעילות ומאושרות</span>
                            </div>
                            <div className="kpi-card">
                                <span className="kpi-title">הזמנות פעילות</span>
                                <span className="kpi-value">{activeRentingsCount}</span>
                                <span className="kpi-sub">שמלות כרגע בהשכרה/הזמנה</span>
                            </div>
                            <div className="kpi-card">
                                <span className="kpi-title">לקוחות רשומות</span>
                                <span className="kpi-value">{totalClients}</span>
                                <span className="kpi-sub">משתמשות פעילות במערכת</span>
                            </div>
                            <div className="kpi-card">
                                <span className="kpi-title">קטגוריות פעילות</span>
                                <span className="kpi-value">{categories.length}</span>
                                <span className="kpi-sub">קולקציות מוצגות באתר</span>
                            </div>
                        </div>

                        {/* אזור גרפים ויזואליים מעוצבים ברוח האתר */}
                        <div className="charts-grid-section">
                            <div className="custom-chart-card">
                                <h3>התפלגות פעילות הקולקציות</h3>
                                <p className="chart-desc">הצגת משקל הקטגוריות השונות במערכת</p>
                                <div className="bar-chart-mock">
                                    {categories.map((cat, index) => {
                                        // יצירת רוחב דמה ויזואלי מרשים לגרף
                                        const widths = ['85%', '65%', '90%', '75%', '50%'];
                                        return (
                                            <div key={cat._id} className="bar-row">
                                                <span className="bar-label">{cat.name}</span>
                                                <div className="bar-track">
                                                    <div className="bar-fill" style={{ width: widths[index % widths.length] }}></div>
                                                </div>
                                            </div>
                                        );
                                    })}
                                    {categories.length === 0 && <p className="empty-chart">אין קטגוריות להצגה בגרף</p>}
                                </div>
                            </div>

                            <div className="custom-chart-card system-status-card">
                                <h3>סטטוס מערכת וביצועים</h3>
                                <p className="chart-desc">בדיקת תקינות רכיבי האתר</p>
                                <div className="status-indicators">
                                    <div className="status-item">
                                        <span className="status-dot green"></span>
                                        <span>חיבור ל-Cloudinary להעלאת תמונות: תקין</span>
                                    </div>
                                    <div className="status-item">
                                        <span className="status-dot green"></span>
                                        <span>Redux Store & API Synchronized: פעיל</span>
                                    </div>
                                    <div className="status-item">
                                        <span className="status-dot green"></span>
                                        <span>הרשאות מנהל (Admin Guard): מאובטח</span>
                                    </div>
                                </div>
                                <div className="quick-actions-box">
                                    <h4>פעולות מהירות</h4>
                                    <div className="actions-buttons-flex">
                                        <button onClick={() => setActiveTab('categories')} className="quick-action-btn">הוספת קטגוריה</button>
                                        <button onClick={() => setActiveTab('rentings')} className="quick-action-btn">צפייה בהזמנות חדשות</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                )}

                {activeTab === 'categories' && <AdminCategories />}
                {activeTab === 'rentings' && <AdminRentings />}
                {activeTab === 'users' && <AdminUsers />}
            </div>
        </div>
    );
}
