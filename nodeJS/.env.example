# יש להעתיק את הקובץ הזה ל-.env ולמלא ערכים אמיתיים - הוא לא נטען ב-git.

# חיבור למסד הנתונים ב-MongoDB Atlas (חובה)
MONGO_CLOUD_URI=

# חיבור למסד נתונים מקומי - אופציונלי, לפיתוח בלבד (connectLocalDB)
MONGO_LOCAL_URI=

# מפתח סודי לחתימת טוקני JWT (חובה) - כל מחרוזת ארוכה ואקראית
JWT_SECRET=

# פרטי משתמש אדמין ראשוני - אופציונלי
ADMIN_EMAIL=
ADMIN_PASSWORD=

# הפורט שהשרת יאזין לו - Render/שירותי אחסון מגדירים את זה אוטומטית,
# בפיתוח מקומי ברירת המחדל היא 2000 אם המשתנה לא מוגדר כלל
PORT=2000
